! setup.pl -d=2 -arch=default
&filelist
  base_filename='spike_topping_solar_jet'
  saveprim=.false.
  autoconvert=.true.
  convert_type='vtuBCCmpi'
  nwauxio=0
/
&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_log=0.02d0
  dtsave_dat=0.10d0
/
&stoplist
  dtmin=1.0d-12
  time_max=0.20d0
/
&methodlist
  time_stepper='threestep'
  flux_scheme=20*'hlld'
  limiter=20*'cada'
  small_pressure=1.0d-10
  small_density=1.0d-10
/
&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
/
&meshlist
  refine_criterion=3
  refine_max_level=2
  block_nx1=16
  block_nx2=16
  domain_nx1=64
  domain_nx2=128
  w_refine_weight(1)=0.3d0
  w_refine_weight(5)=0.4d0
  w_refine_weight(8)=0.3d0
  xprobmin1=-6.0d0
  xprobmax1=6.0d0
  xprobmin2=0.0d0
  xprobmax2=20.0d0
/
&paramlist
  typecourant='maxsum'
  courantpar=0.3d0
  slowsteps=5
/
&mhd_list
  mhd_energy=.true.
  mhd_gravity=.true.
  mhd_thermal_conduction=.false.
  mhd_radiative_cooling=.false.
  typedivbfix='lindepowel'
  B0field=.true.
  B0field_forcefree=.false.
  mhd_eta=1.0d-5
/
&usr_list
  gravity_code=0.12d0
  temperature_ch=0.013333333333d0
  temperature_cor=1.0d0
  transition_height=0.25d0
  transition_width=0.04d0
  base_pressure=20.0d0
  b_open=1.0d0
  guide_ratio=0.5d0
  dipole_depth=0.5d0
  null_height=2.0d0
/
