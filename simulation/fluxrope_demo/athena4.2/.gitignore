.DS_Store

# Autoconf and in-source build products. Formal project builds live in
# Local/athena/ and must not pollute this canonical source tree.
/Makefile
/Makeoptions
/autom4te.cache/
/config.log
/config.status
/bin/

/src/Makefile
/src/Makedepend
/src/config.h
/src/defs.h
/src/problem.c
/src/*.o
/src/*/Makefile
/src/*/Makedepend
/src/*/*.o

# Solver output belongs in Local/athena/ or an explicitly selected run folder.
/tst/2D-mhd/*.bin
/tst/2D-mhd/*.hst
/tst/2D-mhd/*.vtk
/tst/2D-mhd/*.rst
/tst/2D-mhd/*.ppm
