<comment>
problem = periodic double-Harris sheets for jet-conditioned Type III proxies
config  = --with-problem=spike_topping_jet --with-gas=mhd --with-eos=adiabatic --with-order=3 --with-flux=hlld --with-integrator=ctu --enable-resistivity --enable-viscosity

<job>
problem_id      = SpikeToppingJet
maxout          = 4
num_domains     = 1

<output1>
out_fmt         = hst
dt              = 0.005

<output2>
out_fmt         = bin
out             = prim
dt              = 0.05

<output3>
out_fmt         = vtk
dt              = 0.2

<output4>
out_fmt         = rst
dt              = 0.5

<time>
cour_no         = 0.4
nlim            = 10000000
tlim            = 2.0

<domain1>
level           = 0
Nx1             = 512
x1min           = -6.283185307179586
x1max           = 6.283185307179586
bc_ix1          = 4
bc_ox1          = 4

Nx2             = 256
x2min           = -3.141592653589793
x2max           = 3.141592653589793
bc_ix2          = 4
bc_ox2          = 4

Nx3             = 1
x3min           = -0.5
x3max           = 0.5
bc_ix3          = 4
bc_ox3          = 4

AutoWithNProc   = 0
NGrid_x1        = 1
NGrid_x2        = 1
NGrid_x3        = 1

<problem>
gamma           = 1.6666666666666667
b0              = 1.0
rho0            = 1.0
beta            = 1.0
sheet_width     = 0.20
center_fraction = 0.25
perturbation_amp = 0.04
perturbation_width = 0.45
perturbation_kx = 1.0
guide_field_ratio = 0.0
eta_O           = 0.002
Q_H             = 0.0
Q_AD            = 0.0
nu_iso          = 0.002
nu_aniso        = 0.0
