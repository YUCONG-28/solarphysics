<comment>
problem = fluxrope
author  = Chengcai Shen
journal = Wang, Shen, & Lin 2009, ApJ
# config  = ./configure --with-problem=fluxrope --with-gas=mhd \
#           --with-integrator=ctu --with-order=2 --with-flux=roe \
#           --enable-mpi

<job>
problem_id      = fluxrope      # problem ID: basename of output filenames
maxout          = 2             # Output blocks number from 1 -> maxout
num_domains     = 1             # number of Domains in Mesh

<output1>
out_fmt         = hst           # History data dump
dt              = 0.1           # time increment between outputs

<output2>
out_fmt         = vtk           #
out             = prim          # prim or cons
dt              = 0.1           # time increment between outputs

<time>
cour_no         = 0.40          # The Courant, Friedrichs, & Lewy (CFL) Number
tlim            = 1.0           # time limit

<domain1>
level           = 0             # refinement level this Domain (root=0)
Nx1             = 200           # Number of zones in X1-direction
x1min           = -1.0          # minimum value of X1
x1max           = 1.0           # maximum value of X1
bc_ix1          = 2
bc_ox1          = 2

Nx2             = 200           # Number of zones in X2-direction
x2min           = 0.0           # minimum value of X2
x2max           = 2.0           # maximum value of X2
bc_ix2          = 2
bc_ox2          = 2

Nx3             = 1             # Number of zones in X3-direction
x3min           = 0             # minimum value of X3
x3max           = 0             # maximum value of X3
bc_ix3          = 2
bc_ox3          = 2

NGrid_x1 = 1
NGrid_x2 = 1
NGrid_x3 = 1

<problem>
gamma           = 1.6666666667  # gamma = C_p/C_v
pgas_c          = 0.6           # Dimensionless background gas pressure
rho_c           = 1.0           # Dimensionless uniform background density

hb              = 0.0625        # Mirror-source depth used by fluxrope.c
h               = 0.125         # Initial height of the fluxrope
ri              = 0.050         # Radius of the fluxrope (current density)
del             = 0.025         # Edge width
rja             = 600.0         # Current density inside the fluxrope
rmom            = 1.0           # Dipole moment factor used by fluxrope.c
